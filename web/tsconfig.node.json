{
  "compilerOptions": {
    "target": "ES2023",
    // DOM is here because Playwright page.evaluate bodies are compiled with
    // this config but execute inside the browser, so they legitimately use
    // document, requestAnimationFrame, and friends.
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    "playwright.clip.config.ts",
    "eslint.config.js",
    "e2e"
  ]
}
